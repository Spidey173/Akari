# Copy this file to .env and fill in the key for whichever provider you use.

# Gemini (default provider) - free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (alternative, --provider groq) - free tier key from https://console.groq.com/keys
GROQ_API_KEY=

# Ollama (--provider ollama) needs no key, just `ollama serve` running locally
# with a model pulled, e.g.: ollama pull llama3.1
